# ─── Lumora Interiors API ─────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the API listens on
PORT=5000

# MongoDB connection string
#   Local:  mongodb://127.0.0.1:27017/lumora
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lumora?retryWrites=true&w=majority
#   (If the password has special characters like @ : / ? # %, URL-encode them, e.g. @ → %40)
MONGODB_URI=

# Long random string used to sign admin sessions (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an admin session lasts (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# Frontend origin(s) allowed to call this API. Comma-separate multiple values.
CLIENT_ORIGIN=http://localhost:5173

# Used ONLY by `npm run create-admin` to create the first admin account.
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

NODE_ENV=development

# ─── Email alerts for new enquiries ──────────────────────────────
# Every form submission is saved to MongoDB AND emailed to MAIL_TO.
#   mailchimp → Mailchimp Transactional (needs a paid Mailchimp Standard plan,
#               the Transactional add-on and a verified domain you own)
#   brevo     → Brevo HTTP API (free 300/day; works on Render free, which blocks SMTP)
#   smtp      → any SMTP server, e.g. Gmail with an app password (free; local use)
#   none      → save only, no emails
MAIL_PROVIDER=none

# Who receives the alerts (comma-separated)
MAIL_TO=kaviyashree2408@gmail.com,imirinnnb@gmail.com

# Sender shown in the inbox. For Mailchimp this MUST be on your verified domain
# (e.g. enquiries@yourdomain.com). For Gmail SMTP leave it empty — your Gmail address is used.
MAIL_FROM=
MAIL_FROM_NAME=Lumora Interiors Website

# Optional: live site URL, adds an "Open in admin dashboard" link to each email
ADMIN_URL=

# Brevo → top-right menu → SMTP & API → API Keys → Generate a new API key
BREVO_API_KEY=

# Mailchimp Transactional → Settings → SMTP & API Info → "+ New API Key"
MAILCHIMP_TRANSACTIONAL_API_KEY=

# SMTP option 1 — Gmail directly (free):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=<your gmail>  SMTP_PASS=<16-char app password>
#   App password: https://myaccount.google.com/apppasswords (needs 2-Step Verification)
# SMTP option 2 — Brevo (free forever, 300 emails/day, no domain needed):
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   SMTP_USER=<"Login" from Brevo → SMTP & API → SMTP tab, e.g. 9a1b2c001@smtp-brevo.com>
#   SMTP_PASS=<an SMTP key from the same page>   MAIL_FROM=<your Gmail, added as a sender in Brevo>
# SMTP option 3 — GMass (paid after a 7-day / 50-email trial; still sends through your Gmail):
#   SMTP_HOST=smtp.gmass.co   SMTP_PORT=587  SMTP_USER=gmass  SMTP_PASS=<GMass API key>
#   MAIL_FROM=<the Gmail address connected to GMass>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
